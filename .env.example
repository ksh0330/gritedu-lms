# Copy to .env.qa.local (ignored by Git). Do not put credentials in Markdown/chat.
# QA credentials are NOT loaded by the static preview server or build.
QA_BASE_URL=http://127.0.0.1:8000
QA_FIREBASE_TARGET=production
QA_ADMIN_EMAIL=
QA_ADMIN_PASSWORD=
QA_STUDENT_EMAIL=
QA_STUDENT_PASSWORD=
QA_MEMBER_EMAIL=
QA_MEMBER_PASSWORD=
QA_PARENT_EMAIL=
QA_PARENT_PASSWORD=
QA_INSTRUCTOR_EMAIL=
QA_INSTRUCTOR_PASSWORD=
# Optional second account for cross-account DENY tests in an emulator/test project.
QA_MEMBER_B_EMAIL=
QA_MEMBER_B_PASSWORD=
QA_INSTRUCTOR_B_EMAIL=
QA_INSTRUCTOR_B_PASSWORD=
